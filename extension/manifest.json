{
  "manifest_version": 3,
  "name": "PasteGuard",
  "version": "1.0.2",
  "description": "Inspect selected userscript source and compare Solana payment destinations before installing.",
  "action": {
    "default_title": "Open PasteGuard",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png",
      "48": "icon-48.png",
      "128": "icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "contextMenus",
    "storage"
  ],
  "host_permissions": [
    "https://api.devnet.solana.com/*"
  ],
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src https://api.devnet.solana.com;"
  }
}
